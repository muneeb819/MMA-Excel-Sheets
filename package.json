{
  "name": "sheetcraft",
  "productName": "SheetCraft",
  "version": "1.0.0",
  "private": true,
  "description": "Offline desktop spreadsheet suite: formula engine, charts, data cleaning, dashboards, CSV/XLSX and local SQLite.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-assets.mjs",
    "build:fast": "vite build",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=.selftest.mjs --log-level=warning && node .selftest.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "setup": "npm install && npm run build",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "desktop:dev": "node scripts/dev-desktop.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "dev.sheetcraft.app",
    "productName": "SheetCraft",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SheetCraft",
      "artifactName": "SheetCraft-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SheetCraft-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@33.4.11": true
  }
}
